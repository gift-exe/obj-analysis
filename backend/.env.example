# Database (local dev uses a project-local Postgres 18 + pgvector on port 5433)
DATABASE_URL=postgresql+psycopg://localhost:5434/videointel
REDIS_URL=redis://localhost:6379/0
# inline = background threads in the API process; celery = cpu/gpu worker queues
TASK_MODE=inline

# Storage: local (served at /media) or s3 (MinIO / AWS)
STORAGE_BACKEND=local
# S3_ENDPOINT_URL=http://localhost:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin

# Vision-language model: any OpenAI-compatible endpoint.
#   Ollama on a Mac:  VLM_BASE_URL=http://localhost:11434/v1  VLM_MODEL=qwen3-vl-32k
#   vLLM on a GPU:    VLM_BASE_URL=http://gpu-host:8001/v1     VLM_MODEL=Qwen/Qwen3-VL-8B-Instruct
VLM_BASE_URL=http://localhost:11434/v1
VLM_MODEL=qwen3-vl-32k
VLM_API_KEY=not-needed
# Optional: a different model for the agent's reasoning (defaults to the VLM)
# AGENT_BASE_URL=
# AGENT_MODEL=
# AGENT_API_KEY=

DEVICE=auto
ENABLE_MASKS=true
